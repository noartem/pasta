# SQLite database; the file and its directory are created if missing.
DATABASE_URL=sqlite://database/database.sqlite

LISTEN_ADDR=0.0.0.0:8000

# Directory with favicon/robots.txt and the Vite build (`npm run build` writes to public/build).
PUBLIC_DIR=public

# Credentials for the /all page (HTTP Basic auth). /all returns 500 until both are set.
ADMIN_LOGIN=
ADMIN_PASSWORD=

RUST_LOG=info,tower_http=info
